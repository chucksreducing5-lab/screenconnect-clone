# Copy to /etc/remotesupport-web.env on the production server.
# Keep this file private on the server; it contains login and mail secrets.

NODE_ENV=production
PORT=3001
HOST=0.0.0.0
PUBLIC_BASE_URL=https://www.helpsupport.top
DOWNLOAD_BASE_URL=https://www.helpsupport.top

# Change these before going live.
TECH_USERNAME=admin
TECH_PASSWORD=change-this-password
ADMIN_EMAIL=admin@helpsupport.top

# Optional Gmail SMTP reset email settings.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-character-gmail-app-password
# SMTP_FROM=yourname@gmail.com
